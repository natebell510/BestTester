{
  "name": "besttester",
  "version": "1.0.1",
  "description": "Production-grade Playwright + TypeScript QE framework for UI, API, mobile, and AI testing",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=20.x"
  },
  "scripts": {
    "test": "playwright test --config config/playwright.config.ts",
    "test:ui": "playwright test --config config/playwright.config.ts --grep \"@ui\"",
    "test:api": "playwright test --config config/playwright.config.ts --grep \"@api\"",
    "test:ai": "playwright test --config config/playwright.config.ts --grep \"@ai\"",
    "test:smoke": "playwright test --config config/playwright.config.ts --grep \"@smoke\"",
    "test:regression": "playwright test --config config/playwright.config.ts --grep \"@regression\"",
    "test:visual": "playwright test --config config/playwright.config.ts --grep \"@visual\"",
    "visual:update": "playwright test tests/ui/visual --config config/playwright.config.ts --update-snapshots",
    "test:file-ops": "playwright test --config config/playwright.config.ts --grep \"@file-ops\"",
    "test:e2e": "playwright test --config config/playwright.config.ts --grep \"@e2e\"",
    "test:security": "playwright test --config config/playwright.config.ts --grep \"@security\"",
    "test:quarantine": "playwright test tests/flakiness --config config/playwright.config.ts",
    "test:i18n": "playwright test --config config/playwright.config.ts --grep \"@i18n\"",
    "test:auth-matrix": "playwright test --config config/playwright.config.ts --grep \"@auth-matrix\"",
    "test:mobile": "playwright test --config config/playwright.mobile.config.ts --grep \"@mobile\"",
    "test:contracts": "playwright test tests/contracts --config config/playwright.config.ts",
    "test:a11y": "playwright test tests/a11y --config config/playwright.config.ts --grep \"@a11y\"",
    "test:performance": "playwright test tests/performance --config config/playwright.config.ts --grep \"@performance\"",
    "test:graphql": "playwright test tests/api/graphql --config config/playwright.config.ts --grep \"@graphql\"",
    "test:headed": "playwright test --config config/playwright.config.ts --headed",
    "test:debug": "playwright test --config config/playwright.config.ts --debug",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "report:allure": "allure generate allure-results --clean -o allure-report && allure open",
    "report:playwright": "playwright show-report --config config/playwright.config.ts",
    "report:dashboard": "ts-node scripts/generate-dashboard.ts",
    "agent:review": "ts-node agents/code-review-agent.ts",
    "agent:heal": "ts-node agents/test-healer-agent.ts",
    "agent:suggest": "ts-node agents/suggestion-agent.ts",
    "agent:jenkins": "ts-node agents/jenkins-trigger-agent.ts",
    "agent:jira": "ts-node agents/jira-sync-agent.ts",
    "agent:run-and-report": "ts-node agents/run-and-report-agent.ts",
    "setup": "playwright install --with-deps",
    "test:mutation": "stryker run --configFile mutation/stryker.config.ts",
    "setup:env": "bash scripts/setup-env.sh",
    "mcp:server": "ts-node mcp/server/mcp-playwright-server.ts",
    "mcp:server:sse": "cross-env MCP_TRANSPORT=sse ts-node mcp/server/mcp-playwright-server.ts",
    "mcp:generate": "ts-node mcp/client/mcp-test-generator.ts",
    "provision:jenkins": "ts-node scripts/provision-ec2-jenkins.ts",
    "scaffold:page": "ts-node scripts/new-page.ts",
    "scaffold:test": "ts-node scripts/new-test.ts",
    "scaffold:api": "ts-node scripts/new-api.ts",
    "create:test": "ts-node scripts/create-test.ts",
    "k8s:run": "ts-node scripts/k8s-run.ts",
    "jenkins:single-test": "ts-node scripts/trigger-single-test.ts",
    "jenkins:push-jobs": "bash scripts/push-single-test-job.sh",
    "typecheck": "tsc --noEmit",
    "security:audit": "ts-node scripts/security-audit.ts",
    "docker:build": "docker build -t besttester:latest -t besttester:$npm_package_version .",
    "docker:run": "docker run --rm -it -v $(pwd)/reports:/app/reports besttester:latest npm run test:smoke",
    "docker:compose:up": "docker-compose up -d",
    "docker:compose:down": "docker-compose down",
    "docker:compose:logs": "docker-compose logs -f testsuite",
    "docker:compose:test": "docker-compose up --abort-on-container-exit",
    "docker:push": "docker push besttester:latest && docker push besttester:$npm_package_version",
    "prepare": "husky install"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.105.0",
    "@aws-sdk/client-bedrock-runtime": "^3.1075.0",
    "@aws-sdk/client-ec2": "^3.1075.0",
    "@faker-js/faker": "^8.4.1",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@slack/web-api": "^7.17.0",
    "@slack/webhook": "latest",
    "axios": "^1.7.8",
    "cross-env": "^10.1.0",
    "docx": "latest",
    "dotenv": "latest",
    "enquirer": "^2.4.1",
    "exceljs": "^3.4.0",
    "form-data": "^4.0.6",
    "openai": "latest",
    "pdf-parse": "latest",
    "pdfkit": "latest",
    "simple-git": "latest",
    "uuid": "^14.0.1",
    "winston": "latest",
    "zod": "latest"
  },
  "devDependencies": {
    "@aws-sdk/client-bedrock": "^3.1075.0",
    "@aws-sdk/client-iam": "^3.1075.0",
    "@aws-sdk/client-sts": "^3.1075.0",
    "@axe-core/playwright": "^4.11.3",
    "@opentelemetry/exporter-metrics-otlp-http": "^0.219.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.219.0",
    "@opentelemetry/sdk-trace-node": "^2.8.0",
    "@pact-foundation/pact": "^16.5.0",
    "@playwright/test": "latest",
    "@stryker-mutator/core": "latest",
    "@stryker-mutator/typescript-checker": "latest",
    "@types/form-data": "^2.5.2",
    "@types/node": "latest",
    "@types/pdf-parse": "latest",
    "@types/pdfkit": "^0.17.6",
    "@typescript-eslint/eslint-plugin": "latest",
    "@typescript-eslint/parser": "latest",
    "allure-commandline": "latest",
    "allure-playwright": "latest",
    "axe-playwright": "^2.2.2",
    "detect-secrets": "^1.0.6",
    "eslint": "latest",
    "eslint-plugin-playwright": "^2.10.4",
    "eslint-plugin-security": "^4.0.1",
    "gitleaks": "^1.0.0",
    "husky": "latest",
    "license-checker": "^25.0.1",
    "lint-staged": "latest",
    "prettier": "latest",
    "standard-version": "latest",
    "ts-node": "latest",
    "typescript": "latest"
  },
  "lint-staged": {
    "*.ts": [
      "eslint --fix",
      "prettier --write"
    ]
  }
}
