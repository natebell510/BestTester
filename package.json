{
  "name": "besttester",
  "version": "1.0.0",
  "description": "Production-grade Playwright + TypeScript QE framework for UI, API, and AI testing",
  "engines": {
    "node": ">=20.x"
  },
  "scripts": {
    "test": "playwright test --config config/playwright.config.ts",
    "test:ui": "playwright test --config config/playwright.config.ts --grep \"@ui\"",
    "test:api": "playwright test --config config/playwright.config.ts --grep \"@api\"",
    "test:ai": "playwright test --config config/playwright.config.ts --grep \"@ai\"",
    "test:smoke": "playwright test --config config/playwright.config.ts --grep \"@smoke\"",
    "test:regression": "playwright test --config config/playwright.config.ts --grep \"@regression\"",
    "test:visual": "playwright test --config config/playwright.config.ts --grep \"@visual\"",
    "test:file-ops": "playwright test --config config/playwright.config.ts --grep \"@file-ops\"",
    "test:e2e": "playwright test --config config/playwright.config.ts --grep \"@e2e\"",
    "test:security": "playwright test --config config/playwright.config.ts --grep \"@security\"",
    "test:i18n": "playwright test --config config/playwright.config.ts --grep \"@i18n\"",
    "test:auth-matrix": "playwright test --config config/playwright.config.ts --grep \"@auth-matrix\"",
    "test:headed": "playwright test --config config/playwright.config.ts --headed",
    "test:debug": "playwright test --config config/playwright.config.ts --debug",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "report:allure": "allure generate allure-results --clean -o allure-report && allure open",
    "report:playwright": "playwright show-report --config config/playwright.config.ts",
    "agent:review": "ts-node agents/code-review-agent.ts",
    "agent:heal": "ts-node agents/test-healer-agent.ts",
    "agent:suggest": "ts-node agents/suggestion-agent.ts",
    "agent:jenkins": "ts-node agents/jenkins-trigger-agent.ts",
    "agent:jira": "ts-node agents/jira-sync-agent.ts",
    "agent:run-and-report": "ts-node agents/run-and-report-agent.ts",
    "setup": "playwright install --with-deps",
    "test:mutation": "stryker run --configFile mutation/stryker.config.ts",
    "setup:env": "bash scripts/setup-env.sh",
    "mcp:server": "ts-node mcp/server/mcp-playwright-server.ts",
    "mcp:server:sse": "cross-env MCP_TRANSPORT=sse ts-node mcp/server/mcp-playwright-server.ts",
    "mcp:generate": "ts-node mcp/client/mcp-test-generator.ts",
    "provision:jenkins": "ts-node scripts/provision-ec2-jenkins.ts",
    "scaffold:page": "ts-node scripts/new-page.ts",
    "scaffold:test": "ts-node scripts/new-test.ts",
    "scaffold:api": "ts-node scripts/new-api.ts",
    "jenkins:single-test": "ts-node scripts/trigger-single-test.ts",
    "jenkins:push-jobs": "bash scripts/push-single-test-job.sh",
    "typecheck": "tsc --noEmit",
    "prepare": "husky install"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.88.0",
    "@aws-sdk/client-bedrock-runtime": "^3.1030.0",
    "@aws-sdk/client-ec2": "^3.1030.0",
    "@faker-js/faker": "^8.4.1",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@slack/web-api": "^7.15.1",
    "@slack/webhook": "latest",
    "axios": "latest",
    "cross-env": "^10.1.0",
    "docx": "latest",
    "dotenv": "latest",
    "exceljs": "latest",
    "form-data": "^4.0.5",
    "node-jenkins": "latest",
    "openai": "latest",
    "pdf-parse": "latest",
    "pdfkit": "latest",
    "simple-git": "latest",
    "winston": "latest",
    "zod": "latest"
  },
  "devDependencies": {
    "@aws-sdk/client-bedrock": "^3.1030.0",
    "@aws-sdk/client-iam": "^3.1030.0",
    "@aws-sdk/client-sts": "^3.1030.0",
    "@playwright/test": "latest",
    "@stryker-mutator/core": "latest",
    "@stryker-mutator/typescript-checker": "latest",
    "@types/form-data": "^2.5.2",
    "@types/node": "latest",
    "@types/pdf-parse": "latest",
    "@types/pdfkit": "^0.17.5",
    "@typescript-eslint/eslint-plugin": "latest",
    "@typescript-eslint/parser": "latest",
    "allure-commandline": "latest",
    "allure-playwright": "latest",
    "eslint": "latest",
    "husky": "latest",
    "lint-staged": "latest",
    "prettier": "latest",
    "standard-version": "latest",
    "ts-node": "latest",
    "typescript": "latest"
  },
  "lint-staged": {
    "*.ts": [
      "eslint --fix",
      "prettier --write"
    ]
  }
}
