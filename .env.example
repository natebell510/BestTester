# Application URLs
BASE_URL=https://opensource-demo.orangehrmlive.com
STAGING_URL=https://staging.yourapp.com
PROD_URL=https://prod.yourapp.com

# OrangeHRM Credentials
ADMIN_USERNAME=Admin
ADMIN_PASSWORD=admin123

# AWS Bedrock
AWS_BEDROCK_REGION=us-east-1
AWS_ACCESS_KEY_ID=<your_aws_access_key_id>
AWS_SECRET_ACCESS_KEY=<your_aws_secret_access_key>

# Slack
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/T.../B.../...
SLACK_APP_ID=<slack_app_id>
SLACK_CLIENT_ID=<slack_client_id>
SLACK_CLIENT_SECRET=<slack_client_secret>
SLACK_SIGNING_SECRET=<slack_signing_secret>
SLACK_VERIFICATION_TOKEN=<slack_verification_token>
SLACK_TOKEN=<slack_app_token>
SLACK_OAUTH_USER_TOKEN=<slack_oauth_user_token>
SLACK_BOT_TOKEN=<slack_bot_token>
SLACK_TEST_RESULTS_CHANNEL=<slack_channel_id>

# Jenkins
JENKINS_URL=https://jenkins.yourcompany.com
JENKINS_USERNAME=admin
JENKINS_TOKEN=<jenkins_api_token>

# Jira Integration
JIRA_BASE_URL=https://yourorg.atlassian.net
JIRA_EMAIL=<jira_email>
JIRA_API_TOKEN=<jira_api_token>
JIRA_PROJECT_KEY=SCRUM
JIRA_ISSUE_TYPE=Bug

# GitHub
GITHUB_TOKEN=<github_personal_access_token>
GITHUB_REPO=https://github.com/your-org/BestTester

# Reporting
ALLURE_REPORT_URL=https://yourorg.github.io/BestTester

# MCP Configuration
MCP_TRANSPORT=stdio
MCP_SSE_PORT=3001
MCP_LLM_BACKEND=bedrock
MCP_HEADLESS=true

# LLM Judge Configuration
# Primary model (Nova Pro) and judge model (Claude Haiku) must differ to avoid narcissistic bias
PRIMARY_AI_MODEL=amazon.nova-pro-v1:0
JUDGE_MODEL=anthropic.claude-3-haiku-20240307-v1:0
JUDGE_PROVIDER=bedrock
JUDGE_PASS_THRESHOLD=3.5
JUDGE_RETRY_BORDERLINE=true

# Multi-Role Auth
MANAGER_USERNAME=Manager
MANAGER_PASSWORD=manager123
EMPLOYEE_USERNAME=Employee
EMPLOYEE_PASSWORD=employee123

# Security Testing
ENABLE_ZAP_PROXY=false
ZAP_URL=http://localhost:8080
ZAP_API_KEY=<zap_api_key>
