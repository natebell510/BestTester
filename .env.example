# ==========================================
# Test Environment Configuration
# ==========================================

# Environment tier: dev, staging, or prod
# This determines which Zod schema is used for validation
TEST_ENV=dev

# Base URL for the application under test (required)
BASE_URL=https://opensource-demo.orangehrmlive.com

# Browser execution mode
HEADLESS=true

# CI environment flag (set automatically by GitHub Actions, Jenkins, etc.)
CI=false

# Storage state path for session persistence across tests
STORAGE_STATE=auth.json

# Skip global setup phase (useful for CI optimization)
SKIP_GLOBAL_SETUP=false

# ==========================================
# Browser Configuration
# ==========================================

# Run tests on all supported browsers (chromium, firefox, webkit)
ALL_BROWSERS=false

# Test mobile and tablet viewports
MOBILE_TABLET=false

# ==========================================
# AWS Configuration
# ==========================================

# AWS Region for all services (Bedrock, EC2, IAM, STS)
AWS_REGION=us-east-1

# AWS credentials (get from IAM user or assume role)
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key

# ==========================================
# LLM Configuration
# ==========================================

# LLM Provider: bedrock, openai, or anthropic
LLM_PROVIDER=bedrock

# Bedrock model ID for test execution and AI features
# Primary model should support vision (for screenshot analysis)
BEDROCK_MODEL_ID=anthropic.claude-sonnet-4-20250514-v1:0

# Direct Anthropic API key (used when LLM_PROVIDER=anthropic)
ANTHROPIC_API_KEY=your_anthropic_api_key

# OpenAI API key (used when LLM_PROVIDER=openai)
OPENAI_API_KEY=your_openai_api_key

# ==========================================
# Test User Credentials
# ==========================================

# DO NOT commit real credentials - use 1Password or secrets manager
ADMIN_USERNAME=Admin
ADMIN_PASSWORD=admin123

# Multi-role auth for matrix testing
MANAGER_USERNAME=Manager
MANAGER_PASSWORD=manager123

EMPLOYEE_USERNAME=Employee
EMPLOYEE_PASSWORD=employee123

# ==========================================
# Jenkins Integration
# ==========================================

# Jenkins server URL
JENKINS_URL=https://jenkins.yourcompany.com

# Jenkins API credentials
JENKINS_USERNAME=admin
JENKINS_TOKEN=jenkins_api_token

# GitHub repository for CI/CD integration
GITHUB_REPO=owner/repo

# ==========================================
# Slack Integration
# ==========================================

# Incoming webhook for test result notifications
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/T.../B.../...

# Slack app credentials for bot interactions
SLACK_APP_ID=slack_app_id
SLACK_CLIENT_ID=slack_client_id
SLACK_CLIENT_SECRET=slack_client_secret
SLACK_SIGNING_SECRET=slack_signing_secret
SLACK_BOT_TOKEN=xoxb-your-bot-token

# Channel IDs for test result reporting
SLACK_TEST_RESULTS_CHANNEL=C123456789

# ==========================================
# Jira Integration
# ==========================================

# Jira Cloud URL
JIRA_BASE_URL=https://yourorg.atlassian.net

# Jira API credentials (use API token, not password)
JIRA_EMAIL=your-email@example.com
JIRA_API_TOKEN=jira_api_token

# Default Jira project for bug creation
JIRA_PROJECT_KEY=SCRUM

# Default issue type for test failures
JIRA_ISSUE_TYPE=Bug

# ==========================================
# Reporting
# ==========================================

# Allure report server URL for report publishing
ALLURE_REPORT_URL=https://yourorg.github.io/BestTester

# Build number (set by CI/CD pipeline)
BUILD_NUMBER=123

# ==========================================
# MCP Server Configuration
# ==========================================

# Transport method: stdio, sse, or http
MCP_TRANSPORT=stdio

# SSE port (only if MCP_TRANSPORT=sse)
MCP_SSE_PORT=3001

# ==========================================
# Security Testing
# ==========================================

# OWASP ZAP proxy for security testing
ENABLE_ZAP_PROXY=false
ZAP_URL=http://localhost:8080
ZAP_API_KEY=zap_api_key

# 1Password integration for secret management
OP_SERVICE_ACCOUNT_TOKEN=your_1password_service_account_token
