apiVersion: v1
kind: Secret
metadata:
  name: besttester-secrets
  namespace: {{ .Values.namespace }}
  labels:
    app: besttester
type: Opaque
stringData:
  ADMIN_PASSWORD: {{ .Values.adminPassword | quote }}
  DATABASE_URL: {{ .Values.databaseUrl | quote }}
  DATABASE_PASSWORD: {{ .Values.databasePassword | quote }}
  ANTHROPIC_API_KEY: {{ .Values.anthropicApiKey | quote }}
  SLACK_WEBHOOK_URL: {{ .Values.slackWebhookUrl | quote }}
  AUTH_TOKEN: {{ .Values.authToken | quote }}
